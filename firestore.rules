rules_version = '2';

// In Firebase Console einfuegen unter: Firestore Database -> Rules.
//
// Normale Schueler-Accounts duerfen nur ihr eigenes Score-Dokument (und
// dessen "attempts") lesen/schreiben. Admin-Accounts (Lehrkraefte) duerfen
// zusaetzlich alle Score-Dokumente lesen/schreiben, um Zugaenge anzulegen,
// zu deaktivieren und die Ergebnisse aller Schueler einzusehen.
//
// WICHTIG: Unten bei ADMIN_UIDS die eigene Firebase-Auth-UID eintragen
// (Firebase Console -> Authentication -> Tab "Users" -> Spalte "User UID").
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.uid in [
        "zU8OpoHJwKWr0kRSmJVdscAbtt03"
      ];
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /scores/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();

      match /attempts/{attemptId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }
  }
}
